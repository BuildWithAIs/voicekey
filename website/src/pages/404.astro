---
import BaseLayout from '../layouts/BaseLayout.astro'

const title = '404 - Page Not Found'
const basePath = (import.meta.env.BASE_URL ?? '/').replace(/\/$/u, '')
---

<BaseLayout title={title} lang="en">
  <main id="not-found-en" class="min-h-screen flex items-center justify-center">
    <div class="text-center p-6">
      <h1 class="text-5xl font-extrabold">404</h1>
      <p class="mt-4 text-lg">Sorry - the page you are looking for does not exist.</p>
      <a href={`${basePath || ''}/`} class="mt-6 inline-block text-primary underline">
        Go to homepage
      </a>
    </div>
  </main>

  <main id="not-found-zh" class="min-h-screen hidden items-center justify-center">
    <div class="text-center p-6">
      <h1 class="text-5xl font-extrabold">404</h1>
      <p class="mt-4 text-lg">抱歉 - 找不到你请求的页面。</p>
      <a href={`${basePath || ''}/zh/`} class="mt-6 inline-block text-primary underline">
        返回首页
      </a>
    </div>
  </main>

  <script is:inline define:vars={{ basePath }}>
    ;(function () {
      try {
        var path = location.pathname
        var normalizedBase = basePath || ''
        var afterBase =
          normalizedBase !== '' && path.startsWith(normalizedBase)
            ? path.slice(normalizedBase.length) || '/'
            : path
        if (!afterBase.startsWith('/')) afterBase = '/' + afterBase

        var isZhPath = afterBase === '/zh' || afterBase.startsWith('/zh/')
        if (
          !isZhPath &&
          navigator.language &&
          navigator.language.toLowerCase().startsWith('zh')
        ) {
          var target =
            normalizedBase + '/zh' + (afterBase === '/' || afterBase === '/404' ? '' : afterBase)
          if (location.pathname !== target) {
            location.replace(target)
            return
          }
        }

        document.documentElement.lang = isZhPath ? 'zh' : 'en'
        var en = document.getElementById('not-found-en')
        var zh = document.getElementById('not-found-zh')
        if (en && zh && isZhPath) {
          en.classList.add('hidden')
          en.classList.remove('flex')
          zh.classList.remove('hidden')
          zh.classList.add('flex')
        }
      } catch (e) {
        // Keep the default English 404 if browser APIs fail.
      }
    })()
  </script>
</BaseLayout>
