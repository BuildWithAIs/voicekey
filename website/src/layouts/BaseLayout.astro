---
/**
 * BaseLayout - shared HTML shell for the marketing site.
 */

interface Props {
  title: string
  description?: string
  lang?: 'en' | 'zh'
  ogImage?: string
}

const {
  title,
  description = 'Voice Key - Voice to text, one key to input. Press hotkey to speak, release to type anywhere.',
  lang = 'en',
  ogImage = '/og.png',
} = Astro.props

const siteName = 'Voice Key'
const fallbackSite = 'https://buildwithais.github.io'
const rawBasePath = import.meta.env.BASE_URL ?? '/'
const basePath = rawBasePath.endsWith('/') ? rawBasePath.slice(0, -1) : rawBasePath
const siteRoot = Astro.site ?? new URL(fallbackSite)
const siteUrl = new URL(`${basePath || '/'}/`, siteRoot).toString().replace(/\/$/u, '')

const canonicalURL = (() => {
  try {
    return new URL(Astro.url.pathname, siteRoot).toString()
  } catch {
    return siteUrl
  }
})()

const withBasePath = (pagePath: string) => {
  const normalizedPath = pagePath === '/' ? '' : pagePath
  return `${basePath}${normalizedPath}` || '/'
}

const hreflangUrls = (() => {
  try {
    let cleanPath = Astro.url.pathname ?? '/'
    if (basePath && basePath !== '/' && cleanPath.startsWith(basePath)) {
      cleanPath = cleanPath.slice(basePath.length) || '/'
    }
    if (!cleanPath.startsWith('/')) cleanPath = `/${cleanPath}`

    const pathWithoutLang =
      cleanPath === '/zh' ? '/' : cleanPath.startsWith('/zh/') ? cleanPath.slice(3) : cleanPath

    return {
      enUrl: new URL(withBasePath(pathWithoutLang), siteRoot).toString(),
      zhUrl: new URL(withBasePath(`/zh${pathWithoutLang === '/' ? '' : pathWithoutLang}`), siteRoot)
        .toString(),
    }
  } catch {
    return { enUrl: siteUrl, zhUrl: siteUrl }
  }
})()

const ogImageUrl = (() => {
  try {
    const normalizedImage = ogImage.replace(/^\//u, '')
    return new URL(normalizedImage, `${siteUrl}/`).toString()
  } catch {
    return `${siteUrl}/${ogImage.replace(/^\//u, '')}`
  }
})()

const assetPath = (fileName: string) => `${basePath}/${fileName.replace(/^\//u, '')}`
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="BuildWithAIs" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:url" content={canonicalURL} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang="en" href={hreflangUrls.enUrl} />
    <link rel="alternate" hreflang="zh" href={hreflangUrls.zhUrl} />
    <link rel="alternate" hreflang="x-default" href={hreflangUrls.enUrl} />

    <link rel="icon" href={assetPath('favicon.ico')} sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href={assetPath('favicon-32x32.png')} />
    <link rel="icon" type="image/png" sizes="16x16" href={assetPath('favicon-16x16.png')} />
    <link rel="apple-touch-icon" href={assetPath('apple-touch-icon.png')} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>

    <script is:inline>
      ;(function () {
        const getTheme = () => {
          try {
            if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
              return localStorage.getItem('theme')
            }
          } catch (e) {
            // localStorage may be unavailable.
          }
          return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'dark'
        }

        const theme = getTheme()
        document.documentElement.classList.toggle('dark', theme === 'dark')

        try {
          if (typeof localStorage !== 'undefined') {
            localStorage.setItem('theme', theme)
          }
        } catch (e) {
          // Ignore storage write failures.
        }
      })()
    </script>
  </head>
  <body
    class="min-h-screen bg-background text-foreground antialiased relative selection:bg-primary/30 selection:text-primary"
  >
    <div
      class="fixed inset-0 z-0 h-full w-full bg-background bg-[linear-gradient(to_right,rgba(128,128,128,0.05)_1px,transparent_1px),linear-gradient(to_bottom,rgba(128,128,128,0.05)_1px,transparent_1px)] bg-[size:40px_40px] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,#000_70%,transparent_100%)] pointer-events-none"
    >
    </div>

    <slot />
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
