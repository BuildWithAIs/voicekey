// @see - https://www.electron.build/configuration/configuration
{
  $schema: 'https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json',
  appId: 'com.buildwithais.voice-key',
  asar: true,
  productName: 'Voice Key',
  directories: {
    output: 'release/${version}',
    buildResources: 'build',
  },
  files: ['dist', 'dist-electron', '!dist-electron/**/*.map', 'package.json'],
  asarUnpack: [
    '**/*.node',
    '**/node_modules/uiohook-napi/**',
    '**/node_modules/@nut-tree-fork/**',
    '**/node_modules/@ffmpeg-installer/ffmpeg/**',
    '**/node_modules/fluent-ffmpeg/**',
    '**/node_modules/sherpa-onnx/**',
  ],
  extraMetadata: {
    main: 'dist-electron/main.mjs', // 更新入口
  },
  mac: {
    target: ['dmg'],
    artifactName: '${productName}-Mac-${version}-${arch}.${ext}',
    extendInfo: {
      NSMicrophoneUsageDescription: 'Voice Key 需要访问麦克风以进行语音转文字录制。',
      NSAccessibilityUsageDescription: 'Voice Key 需要辅助功能权限以将转录后的文字自动输入到当前窗口。',
    },
    hardenedRuntime: true,
    gatekeeperAssess: false,
    icon: 'build/icons/mac/icon.icns',
  },
  win: {
    target: [
      {
        target: 'nsis',
        arch: ['x64'],
      },
    ],
    artifactName: '${productName}-Windows-${version}-Setup.${ext}',
    icon: 'build/icons/win/icon.ico',
  },
  linux: {
    target: [
      {
        target: 'AppImage',
        arch: ['x64'],
      },
      {
        target: 'pacman',
        arch: ['x64'],
      },
    ],
    artifactName: '${productName}-Linux-${version}-${arch}.${ext}',
    executableName: 'voice-key',
    icon: 'build/icons/png',
    category: 'Utility',
    synopsis: 'Push-to-talk voice input',
    description: 'Privacy-first push-to-talk voice input with local speech recognition, optional refinement, translation, and focused-app text injection.',
    maintainer: 'BuildWithAIs <buildwithais@users.noreply.github.com>',
    vendor: 'BuildWithAIs',
    syncDesktopName: true,
    desktop: {
      entry: {
        Keywords: 'voice;dictation;transcription;speech;input;',
      },
    },
  },
  pacman: {
    artifactName: '${productName}-Linux-${version}-${arch}.pkg.tar.zst',
    depends: [
      'gtk3',
      'libnotify',
      'nss',
      'libxss',
      'libxtst',
      'xdg-utils',
      'at-spi2-core',
      'libsecret',
      'wl-clipboard',
      'wtype',
    ],
  },
  nsis: {
    oneClick: false,
    perMachine: false,
    allowToChangeInstallationDirectory: true,
    deleteAppDataOnUninstall: false,
  },
  npmRebuild: true,
}
